    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \". Arabic Feature Selection Module (arabic_feature_selection)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Chi-square test: Select words most correlated with labels\\n\",\n",
    "    \"Mutual Information: Capture non-linear dependencies\\n\",\n",
    "    \"Dimensionality Reduction: PCA and TruncatedSVD\\n\",\n",
    "    \"Embedding Pooling: Mean, max, sum, and weighted pooling\\n\",\n",
    "    \"TF-IDF Weighted Embeddings: Combine importance scores with semantics\"\n",
    "   ],\n",
    "   \"id\": \"9f42d479e13f71c9\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-12-20T22:58:54.827879Z\",\n",
    "     \"start_time\": \"2025-12-20T22:58:54.097238Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from sklearn.feature_extraction.text import TfidfVectorizer, CountVectorizer\\n\",\n",
    "    \"from sklearn.feature_selection import chi2, mutual_info_classif, SelectKBest\\n\",\n",
    "    \"from sklearn.decomposition import PCA, TruncatedSVD\\n\",\n",
    "    \"from typing import List, Dict, Tuple, Optional\\n\",\n",
    "    \"import warnings\\n\",\n",
    "    \"warnings.filterwarnings('ignore')\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# 1. STATISTICAL FEATURE SELECTION\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"class ArabicFeatureSelector:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Statistical feature selection for Arabic text using:\\n\",\n",
    "    \"    - Chi-square test\\n\",\n",
    "    \"    - Mutual Information\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __init__(self, method='chi2', k=500):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            method: 'chi2' or 'mutual_info'\\n\",\n",
    "    \"            k: number of top features to select\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        self.method = method\\n\",\n",
    "    \"        self.k = k\\n\",\n",
    "    \"        self.selector = None\\n\",\n",
    "    \"        self.vectorizer = None\\n\",\n",
    "    \"        self.selected_features = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def fit_transform(self, texts: List[str], labels: np.ndarray) -> np.ndarray:\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Fit selector on training data and transform\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            texts: List of text strings\\n\",\n",
    "    \"            labels: Array of labels\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Returns:\\n\",\n",
    "    \"            Selected features matrix\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        # Create TF-IDF features\\n\",\n",
    "    \"        self.vectorizer = TfidfVectorizer(\\n\",\n",
    "    \"            max_features=5000,\\n\",\n",
    "    \"            ngram_range=(1, 2),  # unigrams and bigrams\\n\",\n",
    "    \"            min_df=2\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        X = self.vectorizer.fit_transform(texts)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Select scoring function\\n\",\n",
    "    \"        if self.method == 'chi2':\\n\",\n",
    "    \"            score_func = chi2\\n\",\n",
    "    \"        elif self.method == 'mutual_info':\\n\",\n",
    "    \"            score_func = mutual_info_classif\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            raise ValueError(f\\\"Unknown method: {self.method}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Fit selector\\n\",\n",
    "    \"        self.selector = SelectKBest(score_func=score_func, k=min(self.k, X.shape[1]))\\n\",\n",
    "    \"        X_selected = self.selector.fit_transform(X, labels)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Get selected feature names\\n\",\n",
    "    \"        feature_names = np.array(self.vectorizer.get_feature_names_out())\\n\",\n",
    "    \"        selected_mask = self.selector.get_support()\\n\",\n",
    "    \"        self.selected_features = feature_names[selected_mask]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        print(f\\\"✓ Selected {X_selected.shape[1]} features using {self.method}\\\")\\n\",\n",
    "    \"        print(f\\\"  Original features: {X.shape[1]}\\\")\\n\",\n",
    "    \"        print(f\\\"  Top 10 features: {list(self.selected_features[:10])}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return X_selected\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def transform(self, texts: List[str]) -> np.ndarray:\\n\",\n",
    "    \"        \\\"\\\"\\\"Transform new texts using fitted selector\\\"\\\"\\\"\\n\",\n",
    "    \"        if self.vectorizer is None or self.selector is None:\\n\",\n",
    "    \"            raise ValueError(\\\"Must call fit_transform first\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        X = self.vectorizer.transform(texts)\\n\",\n",
    "    \"        X_selected = self.selector.transform(X)\\n\",\n",
    "    \"        return X_selected\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def get_feature_scores(self, top_n=20) -> pd.DataFrame:\\n\",\n",
    "    \"        \\\"\\\"\\\"Get scores for top N features\\\"\\\"\\\"\\n\",\n",
    "    \"        if self.selector is None:\\n\",\n",
    "    \"            raise ValueError(\\\"Must call fit_transform first\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        feature_names = np.array(self.vectorizer.get_feature_names_out())\\n\",\n",
    "    \"        scores = self.selector.scores_\\n\",\n",
    "    \"        selected_mask = self.selector.get_support()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Create DataFrame with scores\\n\",\n",
    "    \"        df = pd.DataFrame({\\n\",\n",
    "    \"            'feature': feature_names[selected_mask],\\n\",\n",
    "    \"            'score': scores[selected_mask]\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"        df = df.sort_values('score', ascending=False).head(top_n)\\n\",\n",
    "    \"        return df\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# 2. DIMENSIONALITY REDUCTION\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"class DimensionalityReducer:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Dimensionality reduction using PCA or TruncatedSVD\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __init__(self, method='pca', n_components=50):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            method: 'pca' or 'svd'\\n\",\n",
    "    \"            n_components: number of components to keep\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        self.method = method\\n\",\n",
    "    \"        self.n_components = n_components\\n\",\n",
    "    \"        self.reducer = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def fit_transform(self, X: np.ndarray) -> np.ndarray:\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Fit reducer and transform data\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            X: Feature matrix (dense or sparse)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Returns:\\n\",\n",
    "    \"            Reduced feature matrix\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        if self.method == 'pca':\\n\",\n",
    "    \"            # PCA requires dense matrix\\n\",\n",
    "    \"            if hasattr(X, 'toarray'):\\n\",\n",
    "    \"                X = X.toarray()\\n\",\n",
    "    \"            self.reducer = PCA(n_components=self.n_components, random_state=42)\\n\",\n",
    "    \"        elif self.method == 'svd':\\n\",\n",
    "    \"            # TruncatedSVD works with sparse matrices\\n\",\n",
    "    \"            self.reducer = TruncatedSVD(n_components=self.n_components, random_state=42)\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            raise ValueError(f\\\"Unknown method: {self.method}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        X_reduced = self.reducer.fit_transform(X)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Calculate variance explained\\n\",\n",
    "    \"        if hasattr(self.reducer, 'explained_variance_ratio_'):\\n\",\n",
    "    \"            var_explained = self.reducer.explained_variance_ratio_.sum()\\n\",\n",
    "    \"            print(f\\\"✓ Reduced to {self.n_components} dimensions using {self.method.upper()}\\\")\\n\",\n",
    "    \"            print(f\\\"  Variance explained: {var_explained:.2%}\\\")\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            print(f\\\"✓ Reduced to {self.n_components} dimensions using {self.method.upper()}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return X_reduced\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def transform(self, X: np.ndarray) -> np.ndarray:\\n\",\n",
    "    \"        \\\"\\\"\\\"Transform new data using fitted reducer\\\"\\\"\\\"\\n\",\n",
    "    \"        if self.reducer is None:\\n\",\n",
    "    \"            raise ValueError(\\\"Must call fit_transform first\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if self.method == 'pca' and hasattr(X, 'toarray'):\\n\",\n",
    "    \"            X = X.toarray()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return self.reducer.transform(X)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# 3. EMBEDDING-BASED FEATURE EXTRACTION\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"class EmbeddingFeatureExtractor:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Extract features from word embeddings using various pooling strategies\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __init__(self, embedding_matrix: np.ndarray, vocab: Dict[str, int],\\n\",\n",
    "    \"                 pooling='mean', use_pca=False, pca_dims=None):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            embedding_matrix: Shape [vocab_size+1, embed_dim], row 0 unused\\n\",\n",
    "    \"            vocab: Dictionary mapping words to IDs (1-indexed)\\n\",\n",
    "    \"            pooling: 'mean', 'max', 'sum', or 'weighted'\\n\",\n",
    "    \"            use_pca: Whether to apply PCA after pooling\\n\",\n",
    "    \"            pca_dims: Number of PCA dimensions (if use_pca=True)\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        self.embedding_matrix = embedding_matrix\\n\",\n",
    "    \"        self.vocab = vocab\\n\",\n",
    "    \"        self.pooling = pooling\\n\",\n",
    "    \"        self.use_pca = use_pca\\n\",\n",
    "    \"        self.pca_dims = pca_dims\\n\",\n",
    "    \"        self.pca = None\\n\",\n",
    "    \"        self.embed_dim = embedding_matrix.shape[1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def _pool_embeddings(self, token_ids: List[int], weights: Optional[List[float]] = None) -> np.ndarray:\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Pool embeddings for a sequence of token IDs\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            token_ids: List of token IDs (1-indexed)\\n\",\n",
    "    \"            weights: Optional weights for weighted pooling\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Returns:\\n\",\n",
    "    \"            Pooled embedding vector\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        if len(token_ids) == 0:\\n\",\n",
    "    \"            return np.zeros(self.embed_dim)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Get embeddings for all tokens\\n\",\n",
    "    \"        embeddings = self.embedding_matrix[token_ids]  # [seq_len, embed_dim]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if self.pooling == 'mean':\\n\",\n",
    "    \"            return embeddings.mean(axis=0)\\n\",\n",
    "    \"        elif self.pooling == 'max':\\n\",\n",
    "    \"            return embeddings.max(axis=0)\\n\",\n",
    "    \"        elif self.pooling == 'sum':\\n\",\n",
    "    \"            return embeddings.sum(axis=0)\\n\",\n",
    "    \"        elif self.pooling == 'weighted':\\n\",\n",
    "    \"            if weights is None:\\n\",\n",
    "    \"                weights = np.ones(len(token_ids))\\n\",\n",
    "    \"            weights = np.array(weights).reshape(-1, 1)\\n\",\n",
    "    \"            return (embeddings * weights).sum(axis=0) / weights.sum()\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            raise ValueError(f\\\"Unknown pooling method: {self.pooling}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def transform(self, token_sequences: List[List[int]],\\n\",\n",
    "    \"                  tfidf_weights: Optional[List[List[float]]] = None) -> np.ndarray:\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Transform token sequences to embedding features\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            token_sequences: List of token ID sequences\\n\",\n",
    "    \"            tfidf_weights: Optional TF-IDF weights for weighted pooling\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Returns:\\n\",\n",
    "    \"            Feature matrix [n_samples, embed_dim] or [n_samples, pca_dims]\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        features = []\\n\",\n",
    "    \"        for i, seq in enumerate(token_sequences):\\n\",\n",
    "    \"            if tfidf_weights is not None:\\n\",\n",
    "    \"                weights = tfidf_weights[i]\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                weights = None\\n\",\n",
    "    \"            features.append(self._pool_embeddings(seq, weights))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        X = np.array(features)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Apply PCA if requested\\n\",\n",
    "    \"        if self.use_pca and self.pca_dims is not None:\\n\",\n",
    "    \"            if self.pca is None:\\n\",\n",
    "    \"                self.pca = PCA(n_components=self.pca_dims, random_state=42)\\n\",\n",
    "    \"                X = self.pca.fit_transform(X)\\n\",\n",
    "    \"                var_explained = self.pca.explained_variance_ratio_.sum()\\n\",\n",
    "    \"                print(f\\\"✓ Applied PCA: {self.embed_dim}D → {self.pca_dims}D\\\")\\n\",\n",
    "    \"                print(f\\\"  Variance explained: {var_explained:.2%}\\\")\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                X = self.pca.transform(X)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return X\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# 4. TF-IDF WEIGHTED EMBEDDINGS\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"class TfidfWeightedEmbeddings:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Combine TF-IDF weights with word embeddings\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __init__(self, embedding_matrix: np.ndarray, vocab: Dict[str, int]):\\n\",\n",
    "    \"        self.embedding_matrix = embedding_matrix\\n\",\n",
    "    \"        self.vocab = vocab\\n\",\n",
    "    \"        self.tfidf_vectorizer = None\\n\",\n",
    "    \"        self.id_to_word = {v: k for k, v in vocab.items()}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def fit_transform(self, texts: List[str], token_sequences: List[List[int]]) -> np.ndarray:\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Compute TF-IDF weighted embeddings\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            texts: List of text strings\\n\",\n",
    "    \"            token_sequences: Corresponding token ID sequences\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Returns:\\n\",\n",
    "    \"            Weighted embedding features\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        # Compute TF-IDF\\n\",\n",
    "    \"        self.tfidf_vectorizer = TfidfVectorizer(vocabulary=self.vocab)\\n\",\n",
    "    \"        tfidf_matrix = self.tfidf_vectorizer.fit_transform(texts)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Extract TF-IDF weights for each sequence\\n\",\n",
    "    \"        features = []\\n\",\n",
    "    \"        for i, seq in enumerate(token_sequences):\\n\",\n",
    "    \"            if len(seq) == 0:\\n\",\n",
    "    \"                features.append(np.zeros(self.embedding_matrix.shape[1]))\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"            # Get TF-IDF weights for this document\\n\",\n",
    "    \"            doc_tfidf = tfidf_matrix[i].toarray().flatten()\\n\",\n",
    "    \"\\n\",\n",
    "    \"            # Weight embeddings by TF-IDF\\n\",\n",
    "    \"            weighted_sum = np.zeros(self.embedding_matrix.shape[1])\\n\",\n",
    "    \"            total_weight = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"            for token_id in seq:\\n\",\n",
    "    \"                word = self.id_to_word.get(token_id)\\n\",\n",
    "    \"                if word and word in self.vocab:\\n\",\n",
    "    \"                    tfidf_weight = doc_tfidf[self.vocab[word] - 1]\\n\",\n",
    "    \"                    weighted_sum += self.embedding_matrix[token_id] * tfidf_weight\\n\",\n",
    "    \"                    total_weight += tfidf_weight\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if total_weight > 0:\\n\",\n",
    "    \"                features.append(weighted_sum / total_weight)\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                features.append(weighted_sum)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return np.array(features)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# 5. COMPLETE PIPELINE\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"class ArabicFeaturePipeline:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Complete feature extraction pipeline with multiple options\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __init__(self, method='embedding', **kwargs):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            method: 'statistical', 'embedding', 'tfidf_weighted', or 'combined'\\n\",\n",
    "    \"            **kwargs: Parameters for specific methods\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        self.method = method\\n\",\n",
    "    \"        self.kwargs = kwargs\\n\",\n",
    "    \"        self.extractor = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def fit_transform(self, texts: List[str], token_sequences: List[List[int]],\\n\",\n",
    "    \"                     labels: np.ndarray, embedding_matrix: Optional[np.ndarray] = None,\\n\",\n",
    "    \"                     vocab: Optional[Dict[str, int]] = None) -> np.ndarray:\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Extract features based on chosen method\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        if self.method == 'statistical':\\n\",\n",
    "    \"            selector_method = self.kwargs.get('selector', 'chi2')\\n\",\n",
    "    \"            k = self.kwargs.get('k', 500)\\n\",\n",
    "    \"            self.extractor = ArabicFeatureSelector(method=selector_method, k=k)\\n\",\n",
    "    \"            X = self.extractor.fit_transform(texts, labels)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            # Optional: apply dimensionality reduction\\n\",\n",
    "    \"            if self.kwargs.get('reduce_dim', False):\\n\",\n",
    "    \"                n_components = self.kwargs.get('n_components', 50)\\n\",\n",
    "    \"                reducer = DimensionalityReducer(method='svd', n_components=n_components)\\n\",\n",
    "    \"                X = reducer.fit_transform(X)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            return X\\n\",\n",
    "    \"\\n\",\n",
    "    \"        elif self.method == 'embedding':\\n\",\n",
    "    \"            if embedding_matrix is None or vocab is None:\\n\",\n",
    "    \"                raise ValueError(\\\"embedding_matrix and vocab required for embedding method\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"            pooling = self.kwargs.get('pooling', 'mean')\\n\",\n",
    "    \"            use_pca = self.kwargs.get('use_pca', False)\\n\",\n",
    "    \"            pca_dims = self.kwargs.get('pca_dims', 30)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            self.extractor = EmbeddingFeatureExtractor(\\n\",\n",
    "    \"                embedding_matrix, vocab, pooling=pooling,\\n\",\n",
    "    \"                use_pca=use_pca, pca_dims=pca_dims\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"            X = self.extractor.transform(token_sequences)\\n\",\n",
    "    \"            return X\\n\",\n",
    "    \"\\n\",\n",
    "    \"        elif self.method == 'tfidf_weighted':\\n\",\n",
    "    \"            if embedding_matrix is None or vocab is None:\\n\",\n",
    "    \"                raise ValueError(\\\"embedding_matrix and vocab required\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"            self.extractor = TfidfWeightedEmbeddings(embedding_matrix, vocab)\\n\",\n",
    "    \"            X = self.extractor.fit_transform(texts, token_sequences)\\n\",\n",
    "    \"            return X\\n\",\n",
    "    \"\\n\",\n",
    "    \"        elif self.method == 'combined':\\n\",\n",
    "    \"            # Combine statistical + embedding features\\n\",\n",
    "    \"            stat_selector = ArabicFeatureSelector(method='chi2', k=200)\\n\",\n",
    "    \"            X_stat = stat_selector.fit_transform(texts, labels)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            emb_extractor = EmbeddingFeatureExtractor(\\n\",\n",
    "    \"                embedding_matrix, vocab, pooling='mean'\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"            X_emb = emb_extractor.transform(token_sequences)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            # Concatenate features\\n\",\n",
    "    \"            if hasattr(X_stat, 'toarray'):\\n\",\n",
    "    \"                X_stat = X_stat.toarray()\\n\",\n",
    "    \"            X = np.hstack([X_stat, X_emb])\\n\",\n",
    "    \"\\n\",\n",
    "    \"            print(f\\\"✓ Combined features: {X_stat.shape[1]} statistical + {X_emb.shape[1]} embedding = {X.shape[1]} total\\\")\\n\",\n",
    "    \"            return X\\n\",\n",
    "    \"\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            raise ValueError(f\\\"Unknown method: {self.method}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# 6. EXAMPLE USAGE\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"def example_feature_selection(texts_train, texts_test, y_train, y_test,\\n\",\n",
    "    \"                              final_list_train, final_list_test,\\n\",\n",
    "    \"                              embedding_matrix, vocab):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Example showing different feature selection approaches\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    print(\\\"=\\\" * 60)\\n\",\n",
    "    \"    print(\\\"FEATURE SELECTION EXAMPLES\\\")\\n\",\n",
    "    \"    print(\\\"=\\\" * 60)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Example 1: Chi-square feature selection\\n\",\n",
    "    \"    print(\\\"\\\\n1️⃣ Chi-square Feature Selection\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 60)\\n\",\n",
    "    \"    selector = ArabicFeatureSelector(method='chi2', k=300)\\n\",\n",
    "    \"    X_train_chi2 = selector.fit_transform(texts_train, y_train)\\n\",\n",
    "    \"    X_test_chi2 = selector.transform(texts_test)\\n\",\n",
    "    \"    print(f\\\"Train shape: {X_train_chi2.shape}\\\")\\n\",\n",
    "    \"    print(f\\\"Test shape: {X_test_chi2.shape}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Example 2: Mutual Information\\n\",\n",
    "    \"    print(\\\"\\\\n2️⃣ Mutual Information Feature Selection\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 60)\\n\",\n",
    "    \"    selector_mi = ArabicFeatureSelector(method='mutual_info', k=300)\\n\",\n",
    "    \"    X_train_mi = selector_mi.fit_transform(texts_train, y_train)\\n\",\n",
    "    \"    X_test_mi = selector_mi.transform(texts_test)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Example 3: Mean pooling of embeddings\\n\",\n",
    "    \"    print(\\\"\\\\n3️⃣ Mean Pooling of Word Embeddings\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 60)\\n\",\n",
    "    \"    emb_extractor = EmbeddingFeatureExtractor(\\n\",\n",
    "    \"        embedding_matrix, vocab, pooling='mean'\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    X_train_emb = emb_extractor.transform(final_list_train)\\n\",\n",
    "    \"    X_test_emb = emb_extractor.transform(final_list_test)\\n\",\n",
    "    \"    print(f\\\"Train shape: {X_train_emb.shape}\\\")\\n\",\n",
    "    \"    print(f\\\"Test shape: {X_test_emb.shape}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Example 4: Embeddings with PCA\\n\",\n",
    "    \"    print(\\\"\\\\n4️⃣ Embeddings + PCA\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 60)\\n\",\n",
    "    \"    emb_pca = EmbeddingFeatureExtractor(\\n\",\n",
    "    \"        embedding_matrix, vocab, pooling='mean',\\n\",\n",
    "    \"        use_pca=True, pca_dims=30\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    X_train_pca = emb_pca.transform(final_list_train)\\n\",\n",
    "    \"    X_test_pca = emb_pca.transform(final_list_test)\\n\",\n",
    "    \"    print(f\\\"Train shape: {X_train_pca.shape}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Example 5: TF-IDF weighted embeddings\\n\",\n",
    "    \"    print(\\\"\\\\n5️⃣ TF-IDF Weighted Embeddings\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 60)\\n\",\n",
    "    \"    tfidf_emb = TfidfWeightedEmbeddings(embedding_matrix, vocab)\\n\",\n",
    "    \"    X_train_tfidf = tfidf_emb.fit_transform(texts_train, final_list_train)\\n\",\n",
    "    \"    print(f\\\"Train shape: {X_train_tfidf.shape}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"\\\\n\\\" + \\\"=\\\" * 60)\\n\",\n",
    "    \"    print(\\\"All features extracted successfully! ✓\\\")\\n\",\n",
    "    \"    print(\\\"=\\\" * 60)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        'chi2': (X_train_chi2, X_test_chi2),\\n\",\n",
    "    \"        'mutual_info': (X_train_mi, X_test_mi),\\n\",\n",
    "    \"        'embeddings': (X_train_emb, X_test_emb),\\n\",\n",
    "    \"        'embeddings_pca': (X_train_pca, X_test_pca),\\n\",\n",
    "    \"        'tfidf_weighted': (X_train_tfidf, None)\\n\",\n",
    "    \"    }\"\n",
    "   ],\n",
