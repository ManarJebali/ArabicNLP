    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# Load your full dataset\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = pd.read_excel('Arabic_Depression_15.000_Tweets_Annotated.xlsx')\\n\",\n",
    "    \"# Clean the text\\n\",\n",
    "    \"df = apply_arabic_cleaning(df, text_col='tweet')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Split into train/test\\n\",\n",
    "    \"x_train, x_test, y_train, y_test = train_test_split(\\n\",\n",
    "    \"    df['text'].values,\\n\",\n",
    "    \"    df['label'].values,\\n\",\n",
    "    \"    test_size=0.2,\\n\",\n",
    "    \"    random_state=42\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Tokenize\\n\",\n",
    "    \"final_list_train, encoded_train, final_list_test, encoded_test, vocab = tokenize_arabic(\\n\",\n",
    "    \"    x_train, y_train, x_test, y_test, vocab_size=5000\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Now you can use with your SGNS training code\"\n",
    "   ],\n",
    "   \"id\": \"1607c114fb63f3d2\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Vocabulary size: 5000\\n\",\n",
    "      \"Most common words: ['اكتئاب', 'انا', 'علي', 'ان', 'سعيده', 'الله', 'سعاده', 'الي', 'حزن', 'متفائل']\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
