    "      \"Vocabulary size: 1000\\n\",\n",
    "      \"Most common words: ['اكتئاب', 'انا', 'علي', 'ان', 'سعيده', 'الله', 'سعاده', 'الي', 'حزن', 'متفائل']\\n\",\n",
    "      \"[warn] Skipped 111 invalid/empty sequences while coercing to id lists.\\n\",\n",
    "      \"Epoch 1/5 - avg loss: 2.8849\\n\",\n",
    "      \"Epoch 2/5 - avg loss: 2.8839\\n\",\n",
    "      \"Epoch 3/5 - avg loss: 2.8926\\n\",\n",
    "      \"Epoch 4/5 - avg loss: 2.8992\\n\",\n",
    "      \"Epoch 5/5 - avg loss: 2.8947\\n\",\n",
    "      \"(1001, 50)\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
