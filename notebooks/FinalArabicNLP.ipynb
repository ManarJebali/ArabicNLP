    "   \"source\": \"## Tokenization for arabic\",\n",
    "   \"id\": \"7cf1c509a88e758c\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"initial_id\",\n",
    "   \"metadata\": {\n",
    "    \"collapsed\": true\n",
    "   },\n",
    "   \"outputs\": [],\n",
    "   \"source\": \"\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-12-20T21:38:50.064284Z\",\n",
    "     \"start_time\": \"2025-12-20T21:38:42.909250Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import re\\n\",\n",
    "    \"import unicodedata\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"from collections import Counter\\n\",\n",
    "    \"import nltk\\n\",\n",
    "    \"from nltk.corpus import stopwords\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Download Arabic stopwords\\n\",\n",
    "    \"nltk.download('stopwords')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# STEP 1: Minimal Cleaning for Arabic Text\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Precompiled patterns\\n\",\n",
    "    \"URL_PATTERN = re.compile(r'\\\\b(?:https?://|http://|www\\\\.)\\\\S+\\\\b', re.IGNORECASE)\\n\",\n",
    "    \"EMAIL_PATTERN = re.compile(r'\\\\b[\\\\w\\\\.-]+@[\\\\w\\\\.-]+\\\\.\\\\w+\\\\b')\\n\",\n",
    "    \"MENTION_PATTERN = re.compile(r'@\\\\w+')\\n\",\n",
    "    \"NUMBER_PATTERN = re.compile(r'\\\\d+')\\n\",\n",
    "    \"WHITESPACE_PATTERN = re.compile(r'\\\\s+')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Arabic-specific patterns\\n\",\n",
    "    \"ARABIC_DIACRITICS = re.compile(r'[\\\\u064B-\\\\u065F\\\\u0670]')  # Tashkeel/diacritics\\n\",\n",
    "    \"TATWEEL = re.compile(r'\\\\u0640')  # Tatweel (ـ)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Normalize Arabic characters\\n\",\n",
    "    \"ARABIC_NORMALIZE_MAP = {\\n\",\n",
    "    \"    'أ': 'ا', 'إ': 'ا', 'آ': 'ا', 'ٱ': 'ا',  # Alef variations\\n\",\n",
    "    \"    'ة': 'ه',  # Taa Marbuta to Haa\\n\",\n",
    "    \"    'ى': 'ي',  # Alef Maksura to Yaa\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"TRANSLATE_MAP = {\\n\",\n",
    "    \"    \\\"\\\\u201c\\\": '\\\"', \\\"\\\\u201d\\\": '\\\"', \\\"\\\\u201e\\\": '\\\"', \\\"\\\\u201f\\\": '\\\"',\\n\",\n",
    "    \"    \\\"\\\\u2018\\\": \\\"'\\\", \\\"\\\\u2019\\\": \\\"'\\\", \\\"\\\\u201a\\\": \\\"'\\\", \\\"\\\\u201b\\\": \\\"'\\\",\\n\",\n",
    "    \"    \\\"\\\\u2013\\\": \\\"-\\\", \\\"\\\\u2014\\\": \\\"-\\\", \\\"\\\\u2212\\\": \\\"-\\\",\\n\",\n",
    "    \"    \\\"\\\\u2026\\\": \\\"...\\\",\\n\",\n",
    "    \"    \\\"\\\\u00A0\\\": \\\" \\\",\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _normalize_unicode(s: str) -> str:\\n\",\n",
    "    \"    s = unicodedata.normalize(\\\"NFC\\\", s)\\n\",\n",
    "    \"    return s.translate(str.maketrans(TRANSLATE_MAP))\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _remove_control_chars(s: str) -> str:\\n\",\n",
    "    \"    return \\\"\\\".join(ch for ch in s if not unicodedata.category(ch).startswith(\\\"C\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _normalize_arabic(s: str) -> str:\\n\",\n",
    "    \"    \\\"\\\"\\\"Normalize Arabic-specific characters\\\"\\\"\\\"\\n\",\n",
    "    \"    # Remove diacritics (tashkeel)\\n\",\n",
    "    \"    s = ARABIC_DIACRITICS.sub('', s)\\n\",\n",
    "    \"    # Remove tatweel\\n\",\n",
    "    \"    s = TATWEEL.sub('', s)\\n\",\n",
    "    \"    # Normalize Alef and other variations\\n\",\n",
    "    \"    for old, new in ARABIC_NORMALIZE_MAP.items():\\n\",\n",
    "    \"        s = s.replace(old, new)\\n\",\n",
    "    \"    return s\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _replace_entities(s: str, replace_numbers: bool = True) -> str:\\n\",\n",
    "    \"    s = EMAIL_PATTERN.sub(\\\"<EMAIL>\\\", s)\\n\",\n",
    "    \"    s = URL_PATTERN.sub(\\\"<URL>\\\", s)\\n\",\n",
    "    \"    s = MENTION_PATTERN.sub(\\\"<USER>\\\", s)\\n\",\n",
    "    \"    if replace_numbers:\\n\",\n",
    "    \"        # Also replace Arabic-Indic digits (٠-٩)\\n\",\n",
    "    \"        s = re.sub(r'[\\\\u0660-\\\\u0669]', '<NUM>', s)\\n\",\n",
    "    \"        s = NUMBER_PATTERN.sub(\\\"<NUM>\\\", s)\\n\",\n",
    "    \"    return s\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _normalize_whitespace(s: str) -> str:\\n\",\n",
    "    \"    s = WHITESPACE_PATTERN.sub(\\\" \\\", s)\\n\",\n",
    "    \"    return s.strip()\\n\",\n",
    "    \"\\n\",\n",
    "    \"def clean_arabic_text(text: str, replace_numbers: bool = True) -> str:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Minimal cleaning for Arabic text:\\n\",\n",
    "    \"    - Keep punctuation and emojis\\n\",\n",
    "    \"    - Replace entities: URLs, emails, mentions, numbers\\n\",\n",
    "    \"    - Normalize Arabic characters (remove diacritics, normalize Alef variants)\\n\",\n",
    "    \"    - Remove control characters\\n\",\n",
    "    \"    - Normalize whitespace\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    if not isinstance(text, str):\\n\",\n",
    "    \"        return \\\"\\\"\\n\",\n",
    "    \"    s = _normalize_unicode(text)\\n\",\n",
    "    \"    s = _remove_control_chars(s)\\n\",\n",
    "    \"    s = _normalize_arabic(s)\\n\",\n",
    "    \"    s = _replace_entities(s, replace_numbers=replace_numbers)\\n\",\n",
    "    \"    s = _normalize_whitespace(s)\\n\",\n",
    "    \"    return s\\n\",\n",
    "    \"\\n\",\n",
    "    \"def apply_arabic_cleaning(df: pd.DataFrame, text_col: str = \\\"tweet\\\") -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Apply Arabic cleaning to DataFrame\\\"\\\"\\\"\\n\",\n",
    "    \"    df[\\\"text\\\"] = df[text_col].apply(clean_arabic_text)\\n\",\n",
    "    \"    return df\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# STEP 2: Tokenization for Arabic\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"def preprocess_arabic_string(s):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Preprocess Arabic string:\\n\",\n",
    "    \"    - Remove punctuation\\n\",\n",
    "    \"    - Remove extra whitespace\\n\",\n",
    "    \"    - Remove digits\\n\",\n",
    "    \"    - Keep only Arabic letters\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Keep only Arabic letters, spaces\\n\",\n",
    "    \"    s = re.sub(r'[^\\\\u0600-\\\\u06FF\\\\s]', '', s)\\n\",\n",
    "    \"    # Replace all runs of whitespaces with single space\\n\",\n",
    "    \"    s = re.sub(r\\\"\\\\s+\\\", ' ', s)\\n\",\n",
    "    \"    return s.strip()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def tokenize_arabic(x_train, y_train, x_val, y_val, vocab_size=1000):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Tokenize Arabic text for training and validation sets\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        x_train: Training texts (list of strings)\\n\",\n",
    "    \"        y_train: Training labels\\n\",\n",
    "    \"        x_val: Validation texts (list of strings)\\n\",\n",
    "    \"        y_val: Validation labels\\n\",\n",
    "    \"        vocab_size: Maximum vocabulary size (default: 1000)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        final_list_train: List of token ID sequences for training\\n\",\n",
    "    \"        encoded_train: Encoded training labels\\n\",\n",
    "    \"        final_list_test: List of token ID sequences for validation\\n\",\n",
    "    \"        encoded_test: Encoded validation labels\\n\",\n",
    "    \"        onehot_dict: Dictionary mapping words to IDs\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    word_list = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Load Arabic stopwords\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        stop_words = set(stopwords.words('arabic'))\\n\",\n",
    "    \"    except:\\n\",\n",
    "    \"        print(\\\"Arabic stopwords not found. Using empty set.\\\")\\n\",\n",
    "    \"        stop_words = set()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Build vocabulary from training data\\n\",\n",
    "    \"    for sent in x_train:\\n\",\n",
    "    \"        if not isinstance(sent, str):\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        for word in sent.split():\\n\",\n",
    "    \"            word = preprocess_arabic_string(word)\\n\",\n",
    "    \"            if word and word not in stop_words and len(word) > 1:\\n\",\n",
    "    \"                word_list.append(word)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Count word frequencies\\n\",\n",
    "    \"    corpus = Counter(word_list)\\n\",\n",
    "    \"    # Get top N most common words\\n\",\n",
    "    \"    corpus_ = sorted(corpus, key=corpus.get, reverse=True)[:vocab_size]\\n\",\n",
    "    \"    # Create word-to-id mapping (1-indexed)\\n\",\n",
    "    \"    onehot_dict = {w: i+1 for i, w in enumerate(corpus_)}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"Vocabulary size: {len(onehot_dict)}\\\")\\n\",\n",
    "    \"    print(f\\\"Most common words: {corpus_[:10]}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Tokenize training data\\n\",\n",
    "    \"    final_list_train = []\\n\",\n",
    "    \"    for sent in x_train:\\n\",\n",
    "    \"        if not isinstance(sent, str):\\n\",\n",
    "    \"            final_list_train.append([])\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        tokens = [onehot_dict[preprocess_arabic_string(word)]\\n\",\n",
    "    \"                 for word in sent.split()\\n\",\n",
    "    \"                 if preprocess_arabic_string(word) in onehot_dict.keys()]\\n\",\n",
    "    \"        final_list_train.append(tokens)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Tokenize validation data\\n\",\n",
    "    \"    final_list_test = []\\n\",\n",
    "    \"    for sent in x_val:\\n\",\n",
    "    \"        if not isinstance(sent, str):\\n\",\n",
    "    \"            final_list_test.append([])\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        tokens = [onehot_dict[preprocess_arabic_string(word)]\\n\",\n",
    "    \"                 for word in sent.split()\\n\",\n",
    "    \"                 if preprocess_arabic_string(word) in onehot_dict.keys()]\\n\",\n",
    "    \"        final_list_test.append(tokens)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    encoded_train = np.array(y_train)\\n\",\n",
    "    \"    encoded_test = np.array(y_val)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return final_list_train, encoded_train, final_list_test, encoded_test, onehot_dict\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# EXAMPLE USAGE\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"if __name__ == \\\"__main__\\\":\\n\",\n",
    "    \"    # Example with your data structure\\n\",\n",
    "    \"    # Assuming you have a DataFrame 'df' with columns: tweet, label, etc.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Sample data based on your screenshot\\n\",\n",
    "    \"    sample_data = {\\n\",\n",
    "    \"        'tweet': [\\n\",\n",
    "    \"            'والله شايفينك الناس كلها صابر يا عبد',\\n\",\n",
    "    \"            'أكيد اكتتاب ي زينه شاء الله الحين',\\n\",\n",
    "    \"            'والله انا ما انا عارف اكتتاب ولا انطلاء ولا',\\n\",\n",
    "    \"        ],\\n\",\n",
    "    \"        'label': [1, 1, 1]\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    df = pd.DataFrame(sample_data)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Step 1: Apply cleaning\\n\",\n",
    "    \"    df_clean = apply_arabic_cleaning(df.copy(), text_col='tweet')\\n\",\n",
    "    \"    print(\\\"Cleaned text:\\\")\\n\",\n",
    "    \"    print(df_clean['text'].head())\\n\",\n",
    "    \"    print()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Step 2: Split data\\n\",\n",
    "    \"    from sklearn.model_selection import train_test_split\\n\",\n",
    "    \"    x_train, x_val, y_train, y_val = train_test_split(\\n\",\n",
    "    \"        df_clean['text'].values,\\n\",\n",
    "    \"        df_clean['label'].values,\\n\",\n",
    "    \"        test_size=0.2,\\n\",\n",
    "    \"        random_state=42\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Step 3: Tokenize\\n\",\n",
    "    \"    final_list_train, encoded_train, final_list_test, encoded_test, vocab = tokenize_arabic(\\n\",\n",
    "    \"        x_train, y_train, x_val, y_val, vocab_size=1000\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"Training sequences: {len(final_list_train)}\\\")\\n\",\n",
    "    \"    print(f\\\"Validation sequences: {len(final_list_test)}\\\")\\n\",\n",
    "    \"    print(f\\\"Sample tokenized sequence: {final_list_train[0]}\\\")\"\n",
    "   ],\n",
    "   \"id\": \"b50215ef31c75ec1\",\n",
