    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Padding\",\n",
    "   \"id\": \"fe5ba88a79adbdd4\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-12-20T22:10:40.933726Z\",\n",
    "     \"start_time\": \"2025-12-20T22:10:39.528851Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def padding_(sentences, seq_len):\\n\",\n",
    "    \"    features = np.zeros((len(sentences), seq_len),dtype=int)\\n\",\n",
    "    \"    for ii, review in enumerate(sentences):\\n\",\n",
    "    \"        if len(review) != 0:\\n\",\n",
    "    \"            features[ii, -len(review):] = np.array(review)[:seq_len]\\n\",\n",
    "    \"    return features\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 1️ Split data\\n\",\n",
    "    \"x_train, x_test, y_train, y_test = train_test_split(\\n\",\n",
    "    \"    df[\\\"text\\\"],    # features\\n\",\n",
    "    \"    df[\\\"label\\\"],   # correct label column\\n\",\n",
    "    \"    test_size=0.2,\\n\",\n",
    "    \"    random_state=42\\n\",\n",
    "    \")\\n\",\n",
    "    \"# x_train=merged[\\\"text\\\"].where(merged[\\\"split\\\"] == \\\"train\\\"))\\n\",\n",
    "    \"# x_test=merged.where(merged[\\\"split\\\"] == \\\"test\\\").drop([\\\"source\\\",\\\"split\\\"], axis=1)\\n\",\n",
    "    \"# y_train=merged.where(merged[\\\"split\\\"] == \\\"train\\\").drop([\\\"source\\\",\\\"split\\\"], axis=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 2️ Tokenize\\n\",\n",
    "    \"final_list_train, encoded_train, final_list_test, encoded_test, vocab =  tokenize_arabic(\\n\",\n",
    "    \"    x_train, y_train, x_test, y_test\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 3️ Pad sequences\\n\",\n",
    "    \"x_train_pad = padding_(final_list_train, seq_len=50)\\n\",\n",
    "    \"x_test_pad  = padding_(final_list_test, seq_len=50)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 4️ Labels\\n\",\n",
    "    \"y_train = encoded_train\\n\",\n",
    "    \"y_test  = encoded_test\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Print the first 5 sequences\\n\",\n",
    "    \"print(\\\"First 5 padded sequences:\\\")\\n\",\n",
    "    \"for i in range(5):\\n\",\n",
    "    \"    print(x_train_pad[i])\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Print the shape of the padded training set\\n\",\n",
    "    \"print(\\\"x_train_pad shape:\\\", x_train_pad.shape)\\n\"\n",
    "   ],\n",
