    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# trained word embeddings (we will use it as an input for the RNN LSTM or GRU )\\n\",\n",
    "   \"id\": \"38b5a4f8065d51e7\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-12-20T22:24:04.318Z\",\n",
    "     \"start_time\": \"2025-12-20T22:14:51.567607Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import math\\n\",\n",
    "    \"import random\\n\",\n",
    "    \"from collections import Counter\\n\",\n",
    "    \"from typing import List, Tuple, Dict, Optional\\n\",\n",
    "    \"\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"import torch.nn as nn\\n\",\n",
    "    \"from torch.utils.data import Dataset, DataLoader\\n\",\n",
    "    \"import re\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =========================================\\n\",\n",
    "    \"# Basic SGNS for your tokenize() outputs\\n\",\n",
    "    \"# - final_list_train: List[List[int]] of 1-based token ids\\n\",\n",
    "    \"# - onehot_dict: Dict[word -> id] with ids in [1..V]\\n\",\n",
    "    \"# Adds robust validation/coercion for sequences to avoid TypeError.\\n\",\n",
    "    \"# =========================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _coerce_int_token(tok) -> Optional[int]:\\n\",\n",
    "    \"    # Accept Python/NumPy ints\\n\",\n",
    "    \"    if isinstance(tok, (int, np.integer)):\\n\",\n",
    "    \"        return int(tok)\\n\",\n",
    "    \"    # Accept numeric strings like \\\"123\\\"\\n\",\n",
    "    \"    if isinstance(tok, str):\\n\",\n",
    "    \"        tok = tok.strip()\\n\",\n",
    "    \"        if tok.isdigit():\\n\",\n",
    "    \"            return int(tok)\\n\",\n",
    "    \"        return None\\n\",\n",
    "    \"    return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _coerce_and_validate_id_seqs(\\n\",\n",
    "    \"    seqs_raw,\\n\",\n",
    "    \"    vocab_size: int,\\n\",\n",
    "    \"    max_report: int = 3,\\n\",\n",
    "    \") -> List[List[int]]:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Ensure we have List[List[int]] with ids in [1..vocab_size].\\n\",\n",
    "    \"    - If a sequence is a list/array/tuple: keep only int-like tokens in range.\\n\",\n",
    "    \"    - If a sequence is a single int-like token: wrap as a length-1 list.\\n\",\n",
    "    \"    - If a sequence is a string of digits (e.g., '1 2 3' or '1,2,3'): parse digits.\\n\",\n",
    "    \"    - Otherwise: raise with a helpful message.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    cleaned: List[List[int]] = []\\n\",\n",
    "    \"    bad_examples = []\\n\",\n",
    "    \"    digit_re = re.compile(r\\\"\\\\d+\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for s in seqs_raw:\\n\",\n",
    "    \"        seq_ids: List[int] = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if isinstance(s, (list, tuple, np.ndarray)):\\n\",\n",
    "    \"            for t in s:\\n\",\n",
    "    \"                v = _coerce_int_token(t)\\n\",\n",
    "    \"                if v is not None and 1 <= v <= vocab_size:\\n\",\n",
    "    \"                    seq_ids.append(v)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        elif isinstance(s, (int, np.integer)):\\n\",\n",
    "    \"            v = int(s)\\n\",\n",
    "    \"            if 1 <= v <= vocab_size:\\n\",\n",
    "    \"                seq_ids = [v]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        elif isinstance(s, str):\\n\",\n",
    "    \"            # Try to parse numeric IDs from string\\n\",\n",
    "    \"            nums = [int(m) for m in digit_re.findall(s)]\\n\",\n",
    "    \"            seq_ids = [v for v in nums if 1 <= v <= vocab_size]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            bad_examples.append((type(s).__name__, s))\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if len(seq_ids) >= 2:\\n\",\n",
    "    \"            cleaned.append(seq_ids)\\n\",\n",
    "    \"        elif seq_ids:\\n\",\n",
    "    \"            # Keep singletons? Usually not useful for skip-gram; drop to avoid empty batches.\\n\",\n",
    "    \"            # You can keep them by changing this branch to cleaned.append(seq_ids).\\n\",\n",
    "    \"            pass\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            bad_examples.append((type(s).__name__, s))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if not cleaned:\\n\",\n",
    "    \"        sample = bad_examples[:max_report]\\n\",\n",
    "    \"        raise TypeError(\\n\",\n",
    "    \"            \\\"final_list_train must be a list of integer-ID sequences (ids in [1..V]). \\\"\\n\",\n",
    "    \"            f\\\"No valid sequences could be formed. Examples of invalid entries: {sample}\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if bad_examples:\\n\",\n",
    "    \"        print(f\\\"[warn] Skipped {len(bad_examples)} invalid/empty sequences while coercing to id lists.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return cleaned\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _build_token_freq(seqs: List[List[int]], vocab_size: int) -> np.ndarray:\\n\",\n",
    "    \"    \\\"\\\"\\\"Count token frequencies from 1-based index sequences.\\\"\\\"\\\"\\n\",\n",
    "    \"    freqs = np.zeros(vocab_size + 1, dtype=np.int64)  # +1 so index 0 remains unused\\n\",\n",
    "    \"    for s in seqs:\\n\",\n",
    "    \"        for t in s:\\n\",\n",
    "    \"            if 1 <= t <= vocab_size:\\n\",\n",
    "    \"                freqs[t] += 1\\n\",\n",
    "    \"    return freqs\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _generate_skipgram_pairs(\\n\",\n",
    "    \"    seqs: List[List[int]],\\n\",\n",
    "    \"    window_size: int,\\n\",\n",
    "    \") -> List[Tuple[int, int]]:\\n\",\n",
    "    \"    \\\"\\\"\\\"Produce (center, context) positive pairs from 1-based token id sequences.\\\"\\\"\\\"\\n\",\n",
    "    \"    pairs: List[Tuple[int, int]] = []\\n\",\n",
    "    \"    for seq in seqs:\\n\",\n",
    "    \"        L = len(seq)\\n\",\n",
    "    \"        if L < 2:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        for i, center in enumerate(seq):\\n\",\n",
    "    \"            if center <= 0:\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"            left = max(0, i - window_size)\\n\",\n",
    "    \"            right = min(L, i + window_size + 1)\\n\",\n",
    "    \"            for j in range(left, right):\\n\",\n",
    "    \"                if j == i:\\n\",\n",
    "    \"                    continue\\n\",\n",
    "    \"                ctx = seq[j]\\n\",\n",
    "    \"                if ctx <= 0:\\n\",\n",
    "    \"                    continue\\n\",\n",
    "    \"                pairs.append((center, ctx))\\n\",\n",
    "    \"    return pairs\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"class SkipGramPairsDS(Dataset):\\n\",\n",
    "    \"    def __init__(self, pairs: List[Tuple[int, int]]):\\n\",\n",
    "    \"        self.pairs = pairs\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __len__(self):\\n\",\n",
    "    \"        return len(self.pairs)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __getitem__(self, idx):\\n\",\n",
    "    \"        c, ctx = self.pairs[idx]\\n\",\n",
    "    \"        return torch.tensor(c, dtype=torch.long), torch.tensor(ctx, dtype=torch.long)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _unigram_noise(freqs: np.ndarray, power: float = 0.75) -> torch.Tensor:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Build noise distribution Pn(w) ∝ f(w)^power for indices [0..V], with prob[0]=0 (unused).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    probs = freqs.astype(np.float64) ** power\\n\",\n",
    "    \"    probs[0] = 0.0  # never sample index 0\\n\",\n",
    "    \"    Z = probs.sum()\\n\",\n",
    "    \"    if Z == 0:\\n\",\n",
    "    \"        # fallback to uniform over 1..V\\n\",\n",
    "    \"        probs[:] = 0.0\\n\",\n",
    "    \"        probs[1:] = 1.0\\n\",\n",
    "    \"        Z = probs.sum()\\n\",\n",
    "    \"    probs /= Z\\n\",\n",
    "    \"    return torch.tensor(probs, dtype=torch.float32)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"class SGNS(nn.Module):\\n\",\n",
    "    \"    def __init__(self, vocab_size: int, embed_dim: int):\\n\",\n",
    "    \"        super().__init__()\\n\",\n",
    "    \"        # +1 so row 0 stays unused; your ids are 1..vocab_size\\n\",\n",
    "    \"        self.in_embed = nn.Embedding(vocab_size + 1, embed_dim)\\n\",\n",
    "    \"        self.out_embed = nn.Embedding(vocab_size + 1, embed_dim)\\n\",\n",
    "    \"        self.embed_dim = embed_dim\\n\",\n",
    "    \"        self._init_weights()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def _init_weights(self):\\n\",\n",
    "    \"        bound = 0.5 / self.embed_dim\\n\",\n",
    "    \"        nn.init.uniform_(self.in_embed.weight, -bound, bound)\\n\",\n",
    "    \"        nn.init.zeros_(self.out_embed.weight)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def forward(self, center: torch.Tensor, pos_ctx: torch.Tensor, neg_ctx: torch.Tensor) -> torch.Tensor:\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        center: [B] longs in [1..V]\\n\",\n",
    "    \"        pos_ctx: [B] longs in [1..V]\\n\",\n",
    "    \"        neg_ctx: [B, K] longs in [1..V]\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        v = self.in_embed(center)        # [B, D]\\n\",\n",
    "    \"        u_pos = self.out_embed(pos_ctx)  # [B, D]\\n\",\n",
    "    \"        u_neg = self.out_embed(neg_ctx)  # [B, K, D]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Positive term: log sigma(v · u_pos)\\n\",\n",
    "    \"        pos_score = (v * u_pos).sum(dim=1)                  # [B]\\n\",\n",
    "    \"        pos_loss = torch.log(torch.sigmoid(pos_score) + 1e-12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Negative term: sum log sigma(-v · u_neg)\\n\",\n",
    "    \"        neg_score = torch.bmm(u_neg.neg(), v.unsqueeze(2)).squeeze(2)  # [B, K]\\n\",\n",
    "    \"        neg_loss = torch.log(torch.sigmoid(neg_score) + 1e-12).sum(dim=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        loss = -(pos_loss + neg_loss).mean()\\n\",\n",
    "    \"        return loss\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"@torch.no_grad()\\n\",\n",
    "    \"def extract_embedding_matrix(model: SGNS) -> np.ndarray:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Return the input embedding matrix including the unused row 0.\\n\",\n",
    "    \"    Shape: [vocab_size+1, embed_dim]; your words are at rows 1..V.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    return model.in_embed.weight.detach().cpu().numpy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def train_sgns_for_tokenize_outputs(\\n\",\n",
    "    \"    final_list_train,  # allow any; we coerce inside\\n\",\n",
    "    \"    onehot_dict: Dict[str, int],\\n\",\n",
    "    \"    embed_dim: int = 100,\\n\",\n",
    "    \"    window_size: int = 2,\\n\",\n",
    "    \"    num_negatives: int = 5,\\n\",\n",
    "    \"    min_count: int = 1,            # your tokenize already prunes; keep 1\\n\",\n",
    "    \"    batch_size: int = 4096,\\n\",\n",
    "    \"    epochs: int = 2,\\n\",\n",
    "    \"    lr: float = 0.01,\\n\",\n",
    "    \"    device: Optional[str] = None,\\n\",\n",
    "    \"    seed: int = 42,\\n\",\n",
    "    \") -> Tuple[np.ndarray, int]:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Train Word2Vec (Skip-gram with Negative Sampling) directly on your tokenize() outputs.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"      - embedding_matrix: np.ndarray of shape [V+1, embed_dim] (row 0 unused)\\n\",\n",
    "    \"      - vocab_size: V (so you can set nn.Embedding(V+1, embed_dim, padding_idx=0))\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    random.seed(seed)\\n\",\n",
    "    \"    np.random.seed(seed)\\n\",\n",
    "    \"    torch.manual_seed(seed)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    vocab_size = max(onehot_dict.values())  # ids are 1..V\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Coerce and validate sequences → List[List[int]] with ids in [1..V]\\n\",\n",
    "    \"    final_list_train = _coerce_and_validate_id_seqs(final_list_train, vocab_size)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Build frequencies\\n\",\n",
    "    \"    freqs = _build_token_freq(final_list_train, vocab_size)\\n\",\n",
    "    \"    if min_count > 1:\\n\",\n",
    "    \"        mask = (np.arange(freqs.size) > 0) & (freqs < min_count)\\n\",\n",
    "    \"        freqs[mask] = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Positive pairs\\n\",\n",
    "    \"    pairs = _generate_skipgram_pairs(final_list_train, window_size=window_size)\\n\",\n",
    "    \"    if len(pairs) == 0:\\n\",\n",
    "    \"        raise ValueError(\\\"No skip-gram pairs generated after coercion. Check your inputs.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ds = SkipGramPairsDS(pairs)\\n\",\n",
    "    \"    dl = DataLoader(ds, batch_size=batch_size, shuffle=True, num_workers=0, drop_last=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Negative sampling distribution\\n\",\n",
    "    \"    noise = _unigram_noise(freqs, power=0.75)\\n\",\n",
    "    \"    device = device or (\\\"cuda\\\" if torch.cuda.is_available() else \\\"cpu\\\")\\n\",\n",
    "    \"    noise = noise.to(device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Model + optimizer\\n\",\n",
    "    \"    model = SGNS(vocab_size=vocab_size, embed_dim=embed_dim).to(device)\\n\",\n",
    "    \"    opt = torch.optim.Adam(model.parameters(), lr=lr)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Train\\n\",\n",
    "    \"    model.train()\\n\",\n",
    "    \"    for ep in range(1, epochs + 1):\\n\",\n",
    "    \"        total, steps = 0.0, 0\\n\",\n",
    "    \"        for center, pos_ctx in dl:\\n\",\n",
    "    \"            center = center.to(device)\\n\",\n",
    "    \"            pos_ctx = pos_ctx.to(device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            with torch.no_grad():\\n\",\n",
    "    \"                neg = torch.multinomial(noise, num_samples=num_negatives * center.size(0), replacement=True)\\n\",\n",
    "    \"                neg = neg.view(center.size(0), num_negatives)  # [B, K]\\n\",\n",
    "    \"\\n\",\n",
    "    \"            opt.zero_grad(set_to_none=True)\\n\",\n",
    "    \"            loss = model(center, pos_ctx, neg)\\n\",\n",
    "    \"            loss.backward()\\n\",\n",
    "    \"            opt.step()\\n\",\n",
    "    \"\\n\",\n",
    "    \"            total += loss.item()\\n\",\n",
    "    \"            steps += 1\\n\",\n",
    "    \"        print(f\\\"Epoch {ep}/{epochs} - avg loss: {total / max(1, steps):.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    emb = extract_embedding_matrix(model)  # [V+1, D], row 0 unused\\n\",\n",
    "    \"    return emb, vocab_size\\n\",\n",
    "    \"\\n\",\n",
    "    \"final_list_train, encoded_train, final_list_test, encoded_test, vocab = tokenize_arabic(\\n\",\n",
    "    \"    x_train, y_train, x_test, y_test\\n\",\n",
    "    \")\\n\",\n",
    "    \"emb, V = train_sgns_for_tokenize_outputs(\\n\",\n",
    "    \"        final_list_train=final_list_train,\\n\",\n",
    "    \"        onehot_dict=vocab,\\n\",\n",
    "    \"        embed_dim=50,\\n\",\n",
    "    \"        window_size=2,\\n\",\n",
    "    \"        num_negatives=5,\\n\",\n",
    "    \"        batch_size=8,\\n\",\n",
    "    \"        epochs=5,\\n\",\n",
    "    \"        lr=0.01,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"print(emb.shape)\"\n",
    "   ],\n",
    "   \"id\": \"2adebbe8e01c3eee\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
